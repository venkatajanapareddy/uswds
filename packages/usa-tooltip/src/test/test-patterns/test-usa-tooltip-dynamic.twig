<div class="padding-8">
  <h3>Dynamic Tooltip Test</h3>
  <p>This demo shows a tooltip that can be dynamically updated without creating multiple tooltip instances.</p>
  
  <div class="margin-4">
    <button id="tooltip-btn" type="button" class="usa-button usa-tooltip" data-position="top" title="Initial tooltip text">
      Tooltip Button
    </button>
  </div>

  <div class="margin-4">
    <div class="usa-alert usa-alert--info">
      <div class="usa-alert__body">
        <h4 class="usa-alert__heading">Current tooltip status:</h4>
        <p class="usa-alert__text">
          Tooltip count in DOM: <span id="tooltip-count">0</span><br>
          Visible tooltips: <span id="visible-count">0</span><br>
          Current tooltip text: <span id="current-text">Initial tooltip text</span>
        </p>
      </div>
    </div>
  </div>

  <div class="margin-4">
    <h4>Update tooltip content:</h4>
    <div class="usa-button-group">
      <button id="update-btn-1" type="button" class="usa-button">Set to "State 1"</button>
      <button id="update-btn-2" type="button" class="usa-button">Set to "State 2"</button>
      <button id="update-btn-3" type="button" class="usa-button">Set to "State 3"</button>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Button elements
      const tooltipBtn = document.getElementById('tooltip-btn');
      
      // Update button elements
      const updateBtn1 = document.getElementById('update-btn-1');
      const updateBtn2 = document.getElementById('update-btn-2');
      const updateBtn3 = document.getElementById('update-btn-3');
      
      // Counter/status elements
      const tooltipCountEl = document.getElementById('tooltip-count');
      const visibleCountEl = document.getElementById('visible-count');
      const currentTextEl = document.getElementById('current-text');
      
      // Update counters function
      function updateCounters() {
        const tooltipsInDom = document.querySelectorAll('.usa-tooltip__body').length;
        const visibleTooltips = document.querySelectorAll('.usa-tooltip__body.is-visible').length;
        
        tooltipCountEl.textContent = tooltipsInDom;
        visibleCountEl.textContent = visibleTooltips;
      }
      
      // Update tooltip function
      function updateTooltip(newText) {
        tooltipBtn.setAttribute('title', newText);
        currentTextEl.textContent = newText;
        
        // Force tooltip refresh by triggering mouseover event
        const mouseoverEvent = new MouseEvent('mouseover', {
          bubbles: true,
          cancelable: true
        });
        tooltipBtn.dispatchEvent(mouseoverEvent);
        
        // Update counters after a short delay
        setTimeout(updateCounters, 50);
      }
      
      // Button click handlers
      updateBtn1.addEventListener('click', function() {
        updateTooltip('State 1 - Updated tooltip text');
      });
      
      updateBtn2.addEventListener('click', function() {
        updateTooltip('State 2 - Another tooltip text');
      });
      
      updateBtn3.addEventListener('click', function() {
        updateTooltip('State 3 - Final tooltip state');
      });
      
      // Initialize tooltip count
      setTimeout(updateCounters, 500);
      
      // Add global event listener for visibility changes
      document.addEventListener('mousemove', function() {
        // Update counters with a slight delay to allow DOM changes
        setTimeout(updateCounters, 50);
      });
      
      // When mouse leaves the tooltip, update counters
      document.addEventListener('mouseout', function() {
        setTimeout(updateCounters, 50);
      });
    });
  </script>
</div> 